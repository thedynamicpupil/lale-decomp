# Include project source, tools, tests, research and evidence by default.
# See docs/PUBLICATION_POLICY.md and analysis/public-development-20261020/.
# No blanket bans on analysis/, runtime/, extracted/, media, logs, TXT or BIN.

# Original distribution and protected bundled distribution software.
/lale/
/DOSBox/
/LALE.BAT
/OKUBENI.TXT
/Uninstall.exe
/dosbox.conf
/lale.pdf
/seyh48.ico
# Original game copies, including future disposable runtime copies.
**/game/
**/lale/

# Development prompts (ordinary research TXT remains included).
**/*[Pp]rompt*.txt
/beforephase5.txt
/duringphase4and5.txt
/newfindings_phase5continiues.txt
/prioritiesandfurtherinstructions.txt

# Credentials and machine-local authentication/configuration.
**/.aws/
**/.agents/
**/.codex/
**/.ssh/
**/.env
**/.env.*
!**/.env.example
**/credentials.json
**/credentials.ini
**/id_rsa
**/id_ed25519
/runtime/config/
/runtime/.launch.lock

# Technically impractical machine-specific build/cache output; regenerate locally.
/rust-port/target/
**/__pycache__/
**/*.pyc

